<div class="mb-4 text-center">
  <h1 class="fw-bold">Khám phá Khóa học</h1>
  <p class="text-muted">Chọn khóa học phù hợp với trình độ và mục tiêu của bạn.</p>
</div>

<!-- Thanh tìm kiếm và bộ lọc Ransack -->
<div class="card shadow-sm border-0 mb-4">
  <div class="card-body bg-light rounded">
    <%= search_form_for @q, url: courses_path, method: :get, class: "row g-3 align-items-center" do |f| %>
      <div class="col-md-4">
        <%= f.search_field :title_cont, class: "form-control", placeholder: "Tìm kiếm tên khóa học..." %>
      </div>
      <div class="col-md-2">
        <%= f.select :course_type_eq, Course.course_types.keys.map { |type| [type.upcase, Course.course_types[type]] }, { include_blank: "Mọi loại" }, class: "form-select" %>
      </div>
      <div class="col-md-2">
        <%= f.select :level_eq, Course.levels.keys.map { |lvl| [lvl.titleize, Course.levels[lvl]] }, { include_blank: "Mọi trình độ" }, class: "form-select" %>
      </div>
      <div class="col-md-2">
        <%= f.select :is_premium_eq, [["Premium", true], ["Free", false]], { include_blank: "Free & Premium" }, class: "form-select" %>
      </div>
      <div class="col-md-2 d-grid">
        <%= f.submit "Lọc kết quả", class: "btn btn-primary", data: {disable_with: "Đang lọc..."} %>
      </div>
    <% end %>
  </div>
</div>

<!-- Danh sách khóa học (Grid) -->
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
  <% if @courses.any? %>
    <% @courses.each do |course| %>
      <div class="col">
        <div class="card h-100 shadow-sm border-0 hover-shadow transition">
          <% if course.thumbnail.attached? %>
            <%= image_tag course.thumbnail, class: "card-img-top", style: "aspect-ratio: 16/9; object-fit: cover;" %>
          <% else %>
            <div class="card-img-top bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center text-muted" style="aspect-ratio: 16/9;">
              <span class="fs-4">No Image</span>
            </div>
          <% end %>
          
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle"><%= course.course_type.upcase %></span>
              <% if course.is_premium? %>
                <span class="badge bg-warning text-dark">Premium</span>
              <% else %>
                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle">Free</span>
              <% end %>
            </div>
            
            <h5 class="card-title fw-bold mt-2">
              <%= link_to course.title, course_path(course), class: "text-decoration-none text-dark stretched-link" %>
            </h5>
            
            <p class="card-text text-muted small flex-grow-1 mt-2">
              <%= truncate(course.description, length: 110) %>
            </p>
            
            <div class="mt-auto d-flex justify-content-between align-items-center pt-3 border-top">
              <span class="text-muted small"><%= course.level.titleize %></span>
              <span class="text-muted small fw-bold text-primary"><%= course.exams.published.count %> Đề thi</span>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="col-12 text-center py-5">
      <h5 class="text-muted">Không tìm thấy khóa học nào phù hợp.</h5>
    </div>
  <% end %>
</div>

<!-- Phân trang Kaminari -->
<div class="d-flex justify-content-center">
  <%= paginate @courses%>
</div>

<style>
  .hover-shadow:hover {
    transform: translateY(-5px);
    box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.15)!important;
  }
  .transition {
    transition: all .3s ease;
  }
</style>
