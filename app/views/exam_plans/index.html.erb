<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="mb-0">Kế hoạch thi của tôi</h2>
      <p class="text-muted mb-0">Theo dõi các ngày thi và mục tiêu điểm.</p>
    </div>
    <%= link_to "Tạo kế hoạch mới", new_exam_plan_path, class: "btn btn-primary" %>
  </div>

  <% if @exam_plans.any? %>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Tên kế hoạch</th>
            <th>Loại thi</th>
            <th>Ngày thi</th>
            <th>Điểm mục tiêu</th>
            <th>Trạng thái</th>
            <th class="text-end">Hành động</th>
          </tr>
        </thead>
        <tbody>
          <% @exam_plans.each do |plan| %>
            <tr>
              <td><%= link_to plan.plan_name, exam_plan_path(plan), class: "text-decoration-none" %></td>
              <td><%= plan.exam_type.titleize %></td>
              <td><%= plan.exam_date.strftime("%d/%m/%Y") %></td>
              <td><%= plan.target_score %></td>
              <td>
                <span class="badge <%= plan.is_active ? 'bg-success' : 'bg-secondary' %>">
                  <%= plan.is_active ? "Đang dùng" : "Không dùng" %>
                </span>
              </td>
              <td class="text-end">
                <%= link_to "Sửa", edit_exam_plan_path(plan), class: "btn btn-sm btn-outline-primary me-1" %>
                <%= link_to "Xóa", exam_plan_path(plan), method: :delete, data: { turbo_confirm: "Bạn có chắc chắn muốn xóa kế hoạch này?" }, class: "btn btn-sm btn-outline-danger" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info">
      Bạn chưa có kế hoạch nào. <%= link_to "Tạo kế hoạch mới", new_exam_plan_path %> để bắt đầu.
    </div>
  <% end %>
</div>