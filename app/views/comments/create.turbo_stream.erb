
<% if @comment.parent_id.nil? %>
    <%= turbo_stream.prepend "comments_list", partial: "comments/comment", locals: { comment: @comment }  %>
<% else %>
    <%= turbo_stream.append "reply-#{@comment.parent_id}", partial: "comments/comment", locals: { comment: @comment} %>
<% end %>

<%= turbo_stream.replace "new_comment_form", partial: "comments/form", locals: {commentable: @comment.commentable, parent_id: nil} %>