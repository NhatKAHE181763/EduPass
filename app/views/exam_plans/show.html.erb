<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-xl-8">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h2 class="card-title"><%= @exam_plan.plan_name %></h2>
              <p class="text-muted mb-1"><strong>Loại thi:</strong> <%= @exam_plan.exam_type.titleize %></p>
              <p class="text-muted mb-0"><strong>Ngày thi:</strong> <%= @exam_plan.exam_date.strftime("%d/%m/%Y") %></p>
            </div>
            <span class="badge <%= @exam_plan.is_active ? 'bg-success' : 'bg-secondary' %>">
              <%= @exam_plan.is_active ? "Active" : "Inactive" %>
            </span>
          </div>

          <hr>

          <div class="row">
            <div class="col-md-6 mb-3">
              <h6 class="text-uppercase text-secondary">Mục tiêu điểm</h6>
              <p class="fs-5"><%= @exam_plan.target_score %></p>
            </div>

            <div class="col-md-6 mb-3">
              <h6 class="text-uppercase text-secondary">Ngày tạo</h6>
              <p class="fs-6 text-muted"><%= @exam_plan.created_at.strftime("%d/%m/%Y") %></p>
            </div>

            <div class="col-12">
              <h6 class="text-uppercase text-secondary">Ghi chú</h6>
              <p class="mb-0"><%= @exam_plan.notes.presence || "Không có ghi chú nào." %></p>
            </div>
          </div>

          <div class="mt-4 d-flex gap-2">
            <%= link_to "Quay lại danh sách", exam_plans_path, class: "btn btn-outline-secondary" %>
            <%= link_to "Chỉnh sửa", edit_exam_plan_path(@exam_plan), class: "btn btn-primary" %>
            <%= link_to "Xóa kế hoạch", exam_plan_path(@exam_plan), method: :delete,
                          data: { turbo_confirm: "Bạn có chắc chắn muốn xóa kế hoạch này?" },
                          class: "btn btn-outline-danger" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>