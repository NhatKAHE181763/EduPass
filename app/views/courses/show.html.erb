<div class="mb-2">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-1">
      <li class="breadcrumb-item"><%= link_to "Khóa học", courses_path, class: "text-decoration-none" %></li>
      <li class="breadcrumb-item <%= 'active' if params[:q].blank? %>" aria-current="page">
        <!-- Nếu đang có filter thì tên khóa học biến thành link để click về trang gốc -->
        <%= link_to_if (params[:q].present? || params[:sort_by].present?), @course.title, course_path(@course), class: "text-decoration-none text-dark" %>
      </li>
      
      <!-- Thêm mẩu breadcrumb nếu đang có filter -->
      <% if params[:q].present? || params[:sort_by].present? %>
        <li class="breadcrumb-item active text-primary" aria-current="page">
          Đang lọc kết quả
        </li>
      <% end %>
    </ol>
  </nav>
</div>

<!-- KHU VỰC HIỂN THỊ CÁC BADGE BỘ LỌC ĐANG ACTIVE -->
<% if params[:q].present? || params[:sort_by].present? %>
  <div class="mb-4 d-flex flex-wrap gap-2 align-items-center">
    <span class="text-muted small me-1"><i class="bi bi-funnel"></i> Đang áp dụng:</span>
    
    <!-- 1. Tag Từ khóa tìm kiếm -->
    <% if params.dig(:q, :title_cont).present? %>
      <span class="badge rounded-pill bg-light text-dark border">
        Tên: "<%= params[:q][:title_cont] %>"
      </span>
    <% end %>

    <!-- 2. Các Tag (Kỹ năng, Phần, Dạng) đang được chọn -->
    <% if params.dig(:q, :by_tags).present? %>
      <% active_tag_names = Tag.where(id: params[:q][:by_tags]).pluck(:name) %>
      <% active_tag_names.each do |tag_name| %>
        <span class="badge rounded-pill bg-info bg-opacity-10 text-info border border-info">
          <%= tag_name %>
        </span>
      <% end %>
    <% end %>

    <!-- Nút Clear Filter (Về trang gốc) -->
    <%= link_to "Xoá bộ lọc ✕", course_path(@course), class: "badge rounded-pill bg-danger text-white text-decoration-none ms-2" %>
  </div>
<% else %>
  <div class="mb-4"></div> <!-- Giữ spacing nếu không có filter -->
<% end %>


<div class="row g-4 mb-5">
  <!-- Cột trái: Thông tin khóa học (Sticky) -->
  <div class="col-lg-4">
    <div class="card shadow-sm border-0 sticky-lg-top" style="top: 20px; z-index: 1;">
      <% if @course.thumbnail.attached? %>
        <%= image_tag @course.thumbnail, class: "card-img-top w-100", style: "aspect-ratio: 16/9; object-fit: cover;" %>
      <% else %>
        <div class="card-img-top bg-light d-flex align-items-center justify-content-center text-muted" style="aspect-ratio: 16/9;">
          Chưa có hình ảnh
        </div>
      <% end %>
      
      <div class="card-body p-4">
        <h3 class="card-title fw-bold mb-3"><%= @course.title %></h3>
        
        <div class="d-flex gap-2 mb-3">
          <span class="badge bg-primary bg-opacity-10 text-primary"><%= @course.course_type.upcase %></span>
          <span class="badge bg-info bg-opacity-10 text-dark border"><%= @course.level.titleize %></span>
          <% if @course.is_premium? %>
            <span class="badge bg-warning text-dark">Premium</span>
          <% end %>
        </div>
        
        <hr>
        
        <h6 class="fw-bold mb-2">Giới thiệu:</h6>
        <p class="text-muted"><%= simple_format(@course.description) %></p>
        
        <div class="bg-light p-3 rounded mt-4">
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Giảng viên:</span>
            <strong><%= @course.created_by&.full_name || "Admin" %></strong>
          </div>
          <div class="d-flex justify-content-between">
            <span class="text-muted">Tổng số đề thi:</span>
            <strong><%= @exams.count %></strong>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Cột phải: Danh sách đề thi -->
  <div class="col-lg-8">
    <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h4 class="mb-0 fw-bold">Danh sách Bài thi (<%= @exams.total_count rescue @exams.count %>)</h4>
          <% if params[:q].present? || params[:sort_by].present? %>
            <%= link_to "Xóa lọc", course_path(@course), class: "btn btn-sm btn-light" %>
          <% end %>
        </div>

        <!-- FORM LỌC INLINE CHO HỌC VIÊN -->
        <%= search_form_for @q, url: course_path(@course), method: :get, class: "row g-2" do |f| %>
          
          <div class="col-md-3">
            <%= f.search_field :title_cont, class: "form-control form-control-sm", placeholder: "Tìm tên bài thi..." %>
          </div>
          
          <!-- Các Dropdown Tag (đều dùng name="q[by_tags][]" để gộp vào mảng truyền cho scope) -->
          <div class="col-md-2">
            <%= select_tag "q[by_tags][]", options_from_collection_for_select(@skills, :id, :name, params.dig(:q, :by_tags)), include_blank: "Tất cả Kỹ năng", class: "form-select form-select-sm" %>
          </div>

          <div class="col-md-2">
            <%= select_tag "q[by_tags][]", options_from_collection_for_select(@parts, :id, :name, params.dig(:q, :by_tags)), include_blank: "Tất cả Phần", class: "form-select form-select-sm" %>
          </div>

          <div class="col-md-2">
            <%= select_tag "q[by_tags][]", options_from_collection_for_select(@question_types, :id, :name, params.dig(:q, :by_tags)), include_blank: "Mọi dạng câu", class: "form-select form-select-sm" %>
          </div>

          <div class="col-md-2">
            <%= select_tag :per_page, options_for_select([
              ["1 / trang", "1"],
              ["10 / trang", "10"],
              ["20 / trang", "20"],
              ["50 / trang", "50"]
            ], params[:per_page] || 1), class: "form-select form-select-sm", onchange: "this.form.submit()" %>
          </div>

          <!-- Submit -->
          <div class="col-md-1 text-end">
            <%= f.submit "Lọc", class: "btn btn-sm btn-primary w-100" %>
          </div>
        <% end %>
      </div>

      
      <div class="card-body p-0">
        <div class="list-group list-group-flush">
          <% if @exams.any? %>
            <% @exams.each do |exam| %>
              <% is_locked = @course.is_premium? && (!user_signed_in? || !current_user.has_active_subscription?) %>
                            <div class="list-group-item p-4 d-flex justify-content-between align-items-center hover-bg-light transition">
                <div>
                  <h5 class="mb-2 fw-bold text-dark">
                    <% if is_locked %>
                      <span class="text-warning me-2" title="Premium Only">🔒</span>
                    <% end %>
                    <%= exam.title %>
                  </h5>
                  
                  <!-- Khu vực hiển thị Tags với màu sắc khác nhau -->
                  <div class="mb-2">
                    <% exam.tags.each do |tag| %>
                      <% badge_class = case tag.category.to_sym
                         when :skill then "bg-primary"
                         when :part then "bg-info text-dark"
                         when :question_type then "bg-dark"
                         else "bg-secondary"
                         end %>
                      <span class="badge <%= badge_class %> me-1"><%= tag.name %></span>
                    <% end %>
                  </div>

                  <!-- Khu vực thống kê -->
                  <div class="text-muted small mt-2 d-flex align-items-center flex-wrap gap-3">
                    <span>
                      <i class="bi bi-clock"></i> <%= exam.duration_minutes %> phút
                    </span>
                    <span>
                      <i class="bi bi-people"></i> <%= exam.exam_attempts.count %> lượt thi
                    </span>
                    <span>
                      <i class="bi bi-star"></i> <%= exam.exam_attempts.average(:score).to_f.round(1) %> điểm TB
                    </span>
                  </div>
                </div>
                
                <div class="ms-3">
                  <% if is_locked %>
                    <%= link_to "Nâng cấp", "#", class: "btn btn-warning text-dark px-4 rounded-pill fw-bold" %>
                  <% else %>
                    <%= button_to "Vào thi", start_exam_path(exam), method: :post, class: "btn btn-outline-primary px-4 rounded-pill fw-bold" %>
                  <% end %>
                </div>
              </div>

            <% end %>
          <% else %>
            <div class="p-5 text-center text-muted">
              <span style="font-size: 3rem;">📄</span>
              <p class="mt-3">Khóa học này hiện chưa có bài thi nào được phát hành.</p>
            </div>
          <% end %>
          <% if @exams.respond_to?(:total_pages) && @exams.total_pages > 1%>
            <div class="p-3 d-flex justify-content-center border-top">
              <%= paginate @exams %>
            </div>
          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .hover-bg-light:hover {
    background-color: #f8f9fa;
  }
</style>
