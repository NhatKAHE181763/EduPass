<div class="container py-5 text-center">
    <h2 class="fw-bold mb-5">Nâng cấp EduPass Premium</h2>

    <div class="row justify-content-center gap-4">
        <div class="col-md-3 card shadow-sm p-4 rounded-4 border-0 ">
            <h4 class="fw-bold text-muted mb-3">Monthly</h4>
            <h2 class="my-3">10,000<small class="text-muted fs-6"> đ/tháng</small></h2>
            <%= button_to "Đăng ký", subscriptions_path(plan: "monthly"), method: :post, data: { turbo: false }, class: "btn btn-outline-primary w-100 fw-bold rounded-pill mt-3" %>            
        </div>
        <div class="col-md-3 card shadow-lg p-4 rounded-4 border-primary position-relative">
            <div class="badge bg-primary position-absolute top-0 start-50 translate-middle px-3 py-2 rounded-pill shadow">Phổ biến nhất</div>
            <h4 class="fw-bold text-primary">Quarterly</h4>
            <h2 class="my-3">29,999<small class="text-muted fs-6"> đ/quý</small></h2>
            <%= button_to "Đăng ký ngay", subscriptions_path(plan: "quarterly"), method: :post, data: { turbo: false }, class: "btn btn-primary w-100 fw-bold rounded-pill mt-3" %>
        </div>
        <div class="col-md-3 card shadow-sm p-4 rounded-4 border-0">
            <h4 class="fw-bold text-muted">Yearly</h4>
            <h2 class="my-3">69,999<small class="text-muted fs-6"> đ/năm</small></h2>
            <%= button_to "Đăng ký", subscriptions_path(plan: "yearly"), method: :post, data: { turbo: false }, class: "btn btn-outline-primary w-100 fw-bold rounded-pill mt-3" %>
        </div>
    </div>
</div>