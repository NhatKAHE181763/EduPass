<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="fw-bold">Quản lý Bài thi</h2>
  <%= link_to "Tạo Bài thi mới", new_admin_exam_path, class: "btn btn-primary" %>
</div>

<!-- FORM SEARCH & FILTER BẰNG RANSACK -->
<div class="card shadow-sm border-0 mb-4">
  <div class="card-body">
    <%= search_form_for @q, url: admin_exams_path, method: :get do |f| %>
      <div class="row g-3">
        
        <div class="col-md-3">
          <%= f.label :title_cont, "Tên bài thi", class: "form-label fw-bold" %>
          <%= f.search_field :title_cont, class: "form-control", placeholder: "Nhập từ khoá..." %>
        </div>

        <div class="col-md-2">
          <%= f.label :course_course_type_eq, "Chứng chỉ", class: "form-label fw-bold" %>
          <%= f.select :course_course_type_eq, Course.course_types.keys.map { |k| [k.upcase, Course.course_types[k]] }, { include_blank: "Tất cả" }, class: "form-select" %>
        </div>

        <div class="col-md-2">
          <%= f.label :course_level_eq, "Level", class: "form-label fw-bold" %>
          <%= f.select :course_level_eq, Course.levels.keys.map { |k| [k.titleize, Course.levels[k]] }, { include_blank: "Tất cả" }, class: "form-select" %>
        </div>

        <div class="col-md-2">
          <%= f.label :course_is_premium_eq, "Premium?", class: "form-label fw-bold" %>
          <%= f.select :course_is_premium_eq, [["Có", true], ["Không", false]], { include_blank: "Tất cả" }, class: "form-select" %>
        </div>

        <div class="col-md-3">
          <%= label_tag :sort_by, "Sắp xếp theo", class: "form-label fw-bold" %>
          <%= select_tag :sort_by, options_for_select([
            ["Mới nhất", "newest"], 
            ["Lượt thi nhiều nhất", "most_attempts"], 
            ["Điểm trung bình cao nhất", "avg_score"]
          ], params[:sort_by]), class: "form-select", onchange: "this.form.submit()" %>
        </div>

        <div class="col-12"><hr class="my-2"></div>

        <div class="col-md-4">
          <%= f.label :by_tags, "Kỹ năng (Skill)", class: "form-label" %>
          <%= select_tag "q[by_tags][]", options_from_collection_for_select(@skills, :id, :name, params.dig(:q, :by_tags)), multiple: true, class: "form-select", size: 3 %>
        </div>

        <div class="col-md-4">
          <%= f.label :by_tags, "Phần thi (Part)", class: "form-label" %>
          <%= select_tag "q[by_tags][]", options_from_collection_for_select(@parts, :id, :name, params.dig(:q, :by_tags)), multiple: true, class: "form-select", size: 3 %>
        </div>

        <div class="col-md-4">
          <%= f.label :by_tags, "Dạng câu (Type)", class: "form-label" %>
          <%= select_tag "q[by_tags][]", options_from_collection_for_select(@question_types, :id, :name, params.dig(:q, :by_tags)), multiple: true, class: "form-select", size: 3 %>
        </div>

        <div class="col-12 mt-3 text-end">
          <%= link_to "Xoá bộ lọc", admin_exams_path, class: "btn btn-light me-2" %>
          <%= f.submit "Tìm kiếm & Lọc", class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>


<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4">Tên bài thi</th>
            <th>Khóa học</th>
            <th>Thời gian</th>
            <th>Trạng thái</th>
            <th class="text-end pe-4">Hành động</th>
          </tr>
        </thead>
        <tbody>
          <% if @exams.any? %>
            <% @exams.each do |exam| %>
              <tr>
                <td class="ps-4">
                  <div class="fw-bold text-dark"><%= exam.title %></div>
                  <div class="text-muted small"><%= exam.slug %></div>
                </td>
                <td>
                  <span class="badge bg-info bg-opacity-10 text-info border"><%= exam.course.title %></span>
                </td>
                <td><%= exam.duration_minutes %> phút</td>
                <td>
                  <% if exam.published? %>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle">Published</span>
                  <% else %>
                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle">Draft</span>
                  <% end %>
                </td>
                <td class="text-end pe-4">
                  <div class="d-flex justify-content-end gap-2">
                    <%= button_to toggle_status_admin_exam_path(exam), method: :patch, class: "btn btn-sm #{exam.published? ? 'btn-outline-warning' : 'btn-outline-success'}" do %>
                      <i class="bi <%= exam.published? ? 'bi-eye-slash' : 'bi-eye' %>"></i>
                      <%= exam.published? ? 'Unpublish' : 'Publish' %>
                    <% end %>
                    
                    <%= link_to "Sửa", edit_admin_exam_path(exam), class: "btn btn-sm btn-outline-primary" %>
                    <%= link_to "Preview", preview_admin_exam_path(exam), class: "btn btn-sm btn-outline-info" %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="text-center py-4 text-muted">Chưa có bài thi nào.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="d-flex justify-content-center mt-4">
        <%= paginate @exams %>
      </div>
    </div>
  </div>
</div>
