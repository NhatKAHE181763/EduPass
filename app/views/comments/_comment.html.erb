<div id="<%= dom_id(comment) %>">
    
<div class="d-flex justify-content-between align-items-center mb-2">
    <div class="d-flex align-items-center gap-1">
        <strong><%= comment.user.full_name %></strong> - <small class="text-muted"><%= time_ago_in_words(comment.created_at) %> ago</small>
        <% if comment.is_pinned %>📌<% end %>
    </div>
    <% if user_signed_in? && current_user&.admin?%>
        <div class="d-flex gap-1">
            <% if comment.parent_id.nil? %>
            <%= button_to (comment.is_pinned ? "Bỏ ghim" : "Ghim"), pin_comment_path(comment), method: :patch, class: "btn btn-sm btn-outline-warning text-decoration-none p-1" %>
            <% end %>
            <%= button_to "Xóa", comment_path(comment), method: :delete, data: { turbo_confirm: "Chắc chắn xóa?" }, class: "btn btn-sm btn-outline-danger text-decoration-none p-1" %>
        </div>
    <% end %>
</div>
<p class="mb-2"><%= comment.body %></p>

<div class="d-flex gap-3 align-items-center mb-3">
    <%= render "comments/likes", comment: comment %>
    <% if user_signed_in? %>
        <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-muted fw-bold " onclick="document.getElementById('reply-<%= comment.id %>').style.display='block'">Trả lời</button>
    <% end %>
</div>

<% if user_signed_in? %>
    <div id="reply-<%= comment.id %>" style="display: none;" class="mb-3">
        <%= render "comments/form", commentable: comment.commentable, parent_id: comment.id %>
    </div>
<% end %>
<% if comment.replies.where(is_deleted: false).any? %>
    <div class="mt-3 ps-3 border-start border-2 border-primary border-opacity-25">
        <% comment.replies.where(is_deleted: false).each do |reply| %>
            <%= render "comments/comment", comment: reply %>
        <% end %>
    </div>
<% end %>

</div>