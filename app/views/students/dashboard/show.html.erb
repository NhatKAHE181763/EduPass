<%# app/views/students/dashboard/show.html.erb %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Tổng quan học tập</h2>
  </div>

  <!-- Phần Thống Kê (Thực tế làm bài) -->
  <div class="row mb-5">
    <!-- Card: Tổng bài đã làm -->
    <div class="col-md-4 mb-3">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body d-flex flex-column justify-content-center align-items-center">
          <div class="text-primary mb-2">
            <i class="bi bi-journal-check" style="font-size: 2rem;"></i>
          </div>
          <h6 class="text-muted text-uppercase mb-1">Tổng bài đã làm</h6>
          <h2 class="fw-bold mb-0"><%= @total_exam_attempts %> <span class="fs-6 text-muted">bài</span></h2>
        </div>
      </div>
    </div>

    <!-- Card: Tổng giờ học -->
    <div class="col-md-4 mb-3">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body d-flex flex-column justify-content-center align-items-center">
          <div class="text-success mb-2">
            <i class="bi bi-clock-history" style="font-size: 2rem;"></i>
          </div>
          <h6 class="text-muted text-uppercase mb-1">Thời gian luyện tập</h6>
          <h2 class="fw-bold mb-0"><%= @total_study_hours %> <span class="fs-6 text-muted">giờ</span></h2>
        </div>
      </div>
    </div>

    <!-- Card: Chuỗi ngày học liên tiếp -->
    <div class="col-md-4 mb-3">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body d-flex flex-column justify-content-center align-items-center">
          <div class="text-warning mb-2">
            <i class="bi bi-fire" style="font-size: 2rem;"></i>
          </div>
          <h6 class="text-muted text-uppercase mb-1">Chuỗi luyện tập</h6>
          <h2 class="fw-bold mb-0"><%= @active_streak %> <span class="fs-6 text-muted">ngày</span></h2>
        </div>
      </div>
    </div>
  </div>

  <!-- Phần hiển thị Exam Plans -->
  <div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
      <h5 class="mb-0 fw-bold">Kế hoạch thi của bạn</h5>
      <%= link_to "Tạo kế hoạch mới", new_exam_plan_path, class: "btn btn-sm btn-primary" %>
    </div>
    
    <div class="card-body p-0">
      <% if @exam_plans.any? %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Kỳ thi mục tiêu</th>
                <th>Điểm mục tiêu</th>
                <th>Ngày thi dự kiến</th>
                <th>Ngày tạo</th>
                <th class="text-end">Hành động</th>
              </tr>
            </thead>
            <tbody>
              <% @exam_plans.each do |plan| %>
                <tr>
                  <td><span class="fw-medium"><%= plan.plan_name %></span></td>
                  <td><span class="badge bg-info"><%= plan.target_score %></span></td>
                  <td><%= plan.exam_date&.strftime("%d/%m/%Y") || "Chưa xác định" %></td>
                  <td class="text-muted"><%= plan.created_at.strftime("%d/%m/%Y") %></td>
                  <td class="text-end">
                    <%= link_to "Sửa", edit_exam_plan_path(plan), class: "btn btn-sm btn-outline-secondary" %>
                    <%= link_to "Xóa", exam_plan_path(plan), 
                        data: { turbo_method: :delete, turbo_confirm: "Bạn có chắc chắn muốn xóa kế hoạch này không?" }, 
                        class: "btn btn-sm btn-outline-danger ms-1" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-clipboard-x text-muted mb-3" style="font-size: 3rem;"></i>
          <h5 class="text-muted">Bạn chưa có kế hoạch nào</h5>
          <p class="text-muted mb-0">Hãy tạo kế hoạch để theo dõi mục tiêu học tập của mình nhé!</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
