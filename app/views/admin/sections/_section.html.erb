<%= turbo_frame_tag dom_id(section), class: "list-group-item d-flex justify-content-between align-items-center py-3", data: { id: section.id } do %>
  <div class="d-flex align-items-center gap-3">
    <div class="drag-handle text-muted" style="cursor: grab; font-size: 1.5rem; line-height: 1;">
      &#8942;&#8942;
    </div>
    <div>
      <h6 class="mb-0 fw-bold"><%= section.title %></h6>
      <small class="text-muted"><%= section.section_type.titleize %> • Hướng dẫn: <%= section.instruction.presence || "Không có" %></small>
    </div>
  </div>
  
  <div class="d-flex gap-2">
    <%= link_to "Sửa", edit_admin_exam_section_path(@exam, section), class: "btn btn-sm btn-outline-primary" %>
    <%= button_to "Xóa", admin_exam_section_path(@exam, section), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Xóa section này?" } %>
  </div>
<% end %>
