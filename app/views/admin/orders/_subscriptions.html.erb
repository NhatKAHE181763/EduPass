<div class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Mã gói</th>
          <th>Khách hàng</th>
          <th>Tên gói cước</th>
          <th>Trạng thái</th>
          <th>Ngày kích hoạt</th>
          <th>Ngày hết hạn</th>
        </tr>
      </thead>
      <tbody>
        <% if @active_subscriptions.any? %>
          <% @active_subscriptions.each do |sub| %>
            <tr>
              <td class="text-muted">#<%= sub.id %></td>
              <td>
                <div class="fw-bold"><%= sub.user.full_name %></div>
                <div class="text-muted small"><%= sub.user.email %></div>
              </td>
              <td>
                <span class="badge bg-primary text-uppercase"><%= sub.plan %></span>
              </td>
              <td>
                <span class="badge bg-success"><%= sub.status.titleize %></span>
              </td>
              <td><%= sub.started_at&.strftime("%d/%m/%Y") %></td>
              <td class="fw-bold text-danger"><%= sub.expired_at&.strftime("%d/%m/%Y") %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="text-center py-4 text-muted">Không có gói cước nào đang Active</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <div class="card-footer bg-white pt-3 border-top-0">
    <%= paginate @active_subscriptions, param_name: :sub_page %>
  </div>
</div>
