<%= turbo_frame_tag "new_section" do %>
  <div class="p-3 bg-light border-bottom">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="fw-bold mb-0">Thêm Section mới</h5>
      <!-- Nút hủy để đóng form -->
      <%= link_to "", edit_admin_exam_path(@exam), class: "btn-close" %>
    </div>
    <%= render "form", section: @section %>
  </div>
<% end %>
