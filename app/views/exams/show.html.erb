<% content_for :title, "Thi thử: #{@exam.title} - EduPass" %>
<% content_for :description, "Bài thi #{@exam.title} thuộc khóa học #{@exam.course.title}. Thời gian làm bài: #{@exam.duration_minutes} phút." %>
<% content_for :canonical, exam_url(@exam) %>
<% if @exam.course.thumbnail.attached? %>
  <% content_for :og_image, url_for(@exam.course.thumbnail) %>
<% end %>



<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      
      <div class="mb-4">
        <%= link_to "← Trở lại Khóa học", course_path(@exam.course), class: "text-decoration-none text-muted fw-bold" %>
      </div>

      <div class="card shadow overflow-hidden">
        <div class="card-body p-5 text-center">
          
          <% if @is_locked %>
            <!-- KHÓA -->
            <div class="mb-4">
              <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning rounded-circle" style="width: 80px; height: 80px;">
                <span style="font-size: 2.5rem;">🔒</span>
              </div>
            </div>
            <h2 class="fw-bold mb-3"><%= @exam.title %></h2>
            <p class="text-muted mb-4">Đây là bài thi thuộc Khóa học Premium. Bạn cần nâng cấp tài khoản để có thể tham gia làm bài.</p>
            
            <%= link_to "Nâng cấp Premium", "#", class: "btn btn-warning btn-lg px-5 fw-bold text-dark rounded-pill shadow-sm" %>
          
          <% else %>
            <!-- Unlocked -->
            <h2 class="fw-bold mb-3"><%= @exam.title %></h2>
            
            <%= button_to "Làm bài", start_exam_path(@exam), method: :post, class: "btn btn-primary btn-lg px-5 fw-bold rounded-pill shadow-sm mt-3" %>

            <% if @attempts.present? %>
              <div class="text-start mt-4 border-top pt-4">
                <h5 class="fw-bold mb-3">Lịch sử làm bài</h5>
                <div class="list-group shadow-sm">
                  <% @attempts.each do |attempt| %>
                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">
                      
                      <span class="fw-bold"><%= attempt.score %></span>
                      <% if attempt.submitted? %>
                        <span>Đã nộp</span>
                      <% elsif attempt.in_progress? %>
                        <span>Đang làm</span>
                      <% else %>
                        <span><%= attempt.status %></span>
                      <% end %>
                      <span><%= attempt.started_at.strftime("%d/%m/%Y %H:%M") %></span>
                      <% if attempt.submitted? %>
                        <span><%= Time.at(attempt.actual_duration_seconds.to_i).utc.strftime("%M:%S") %></span>
                      <% end %>

                      <%= link_to "Xem lại", exam_attempt_path(attempt), class: "btn btn-sm btn-success" if attempt.submitted? %>
                      <%= link_to "Tiếp tục", exam_attempt_path(attempt), class: "btn btn-sm btn-warning" if attempt.in_progress? %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
