<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Edupass" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Edupass">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <%= favicon_link_tag asset_path("EduPass.png") %>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    >
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />


    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <title>
      <%= yield(:title).presence || "Edupass - Nền tảng ôn thi tiếng Anh uy tín"%>
    </title>
    <meta name="description" content="<%= yield(:description).presence || 'Khám phá các khóa học và bài thi thử TOEIC, IELTS chất lượng cao.' %>">

    <% if yield(:canonical).present? %>
      <link rel="canonical" href="<%= yield(:canonical) %>">
    <% end %>

    <meta property="og:title" content="<%= yield(:title).presence || 'EduPass' %>">
    <meta property="og:description" content="<%= yield(:description).presence || 'Nền tảng ôn thi tiếng Anh uy tín.'%>">
    <meta property="og:image" content="<%= yield(:og_image).presence || asset_url('EduPass.png')%>">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:type" content="website">

  </head>

  <body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-black shadow-sm">
      <div class="container">
        <%= image_tag "EduPass.png", class: "img-fluid", style: "width: 50px;" %>
        <a class="navbar-brand fw-semibold" href="/">EduPass</a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNavbar"
          aria-controls="mainNavbar"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavbar">
          <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
            <% if user_signed_in? && current_user.admin? %>
              <li class="nav-item"><a class="nav-link" href="<%= admin_dashboard_path %>">Admin</a></li>
            <% end %>            
            <li class="nav-item"><a class="nav-link" href="<%= courses_path %>">Courses</a></li>
            <li class="nav-item"><a class="nav-link" href="<%= student_dashboard_path %>">Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" href="<%= edit_user_profile_path %>">Profile</a></li>
            <% if user_signed_in?%>
              <li class="nav-item">
                <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-danger btn-sm ms-lg-2" %>  
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to "Sign in", new_user_session_path, class: "btn btn-light btn-sm ms-lg-2" %>  
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container py-4">
      <% flash.each do |type, message| %>
        <% next if message.blank? %>
        <% alert_class = case type.to_s
          when "notice" then "success"
          when "alert" then "danger"
          else "info"
        end %>
        <div class="alert alert-<%= alert_class %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="footer mt-auto py-3 border-top bg-white">
      <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <span class="text-muted"><%= Time.current.year %> EduPass</span>
      </div>
    </footer>
  </body>
</html>
