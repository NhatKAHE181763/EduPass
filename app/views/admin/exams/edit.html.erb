<div class="mb-4">
  <h2 class="fw-bold">Sửa Bài thi</h2>
</div>

<%= render "form", exam: @exam %>

<hr class="my-5">

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="fw-bold mb-0">Danh sách Sections</h3>
  <!-- data-turbo-frame="new_section" báo cho Rails biết sẽ load form tạo mới vào khung bên dưới -->
  <div class="dropdown">
    <button class="btn btn-success dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
      + Thêm Section
    </button>
    <ul class="dropdown-menu dropdown-menu-end">
      <li><%= link_to "Reading Section", new_admin_exam_section_path(@exam, section_type: 'reading'), class: "dropdown-item", data: { turbo_frame: "new_section" } %></li>
      <li><%= link_to "Listening Section", new_admin_exam_section_path(@exam, section_type: 'listening'), class: "dropdown-item", data: { turbo_frame: "new_section" } %></li>
    </ul>
  </div>

</div>

<div class="card shadow-sm border-0 mb-4">
  <!-- Khung rỗng để chứa Form thêm mới khi user click nút Thêm -->
  <%= turbo_frame_tag "new_section" %>

  <div class="list-group list-group-flush" 
      data-controller="sortable" 
      data-sortable-url-value="<%= reorder_admin_exam_sections_path(@exam) %>">
      
    <% @exam.sections.order(:order_index).each do |section| %>
      <%= render "admin/sections/section", section: section %>
    <% end %>
  </div>
</div>
