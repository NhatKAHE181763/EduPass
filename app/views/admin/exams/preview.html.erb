<div class="mb-4 d-flex justify-content-between align-items-center">
  <h2 class="fw-bold mb-0">Xem trước: <%= @exam.title %></h2>
  <%= link_to "Trở lại", edit_admin_exam_path(@exam), class: "btn btn-outline-secondary" %>
</div>

<div class="alert alert-warning mb-4 shadow-sm border-0">
  <i class="bi bi-info-circle me-1"></i> Đây là giao diện Xem trước nội dung dành riêng cho Admin. 
  Các đáp án đúng được <strong>tô màu xanh lá</strong> để dễ dàng kiểm tra chéo (Cross-check).
</div>

<% @exam.sections.order(:order_index).each_with_index do |section, s_index| %>
  <div class="card shadow-sm border-0 mb-5">
    <div class="card-header bg-dark text-white py-3">
      <h5 class="mb-0 fw-bold">Section <%= s_index + 1 %>: <%= section.title %></h5>
      <% if section.instruction.present? %>
        <small class="fst-italic text-light"><%= section.instruction %></small>
      <% end %>
    </div>
    
    <div class="card-body">
      <!-- NỘI DUNG ĐỀ BÀI (READING / LISTENING) -->
      <% if section.reading? %>
        <div class="p-4 bg-light rounded mb-4" style="max-height: 350px; overflow-y: auto; border-left: 4px solid #0d6efd;">
          <%= section.passage %>
        </div>
      <% elsif section.listening? && section.audio_file.attached? %>
        <div class="mb-4 p-4 bg-light rounded text-center">
          <audio controls class="w-75">
            <source src="<%= url_for(section.audio_file) %>" type="<%= section.audio_file.content_type %>">
          </audio>
        </div>
      <% end %>

      <!-- DANH SÁCH CÂU HỎI -->
      <% section.questions.order(:order_index).each_with_index do |question, q_index| %>
        <div class="mb-4 p-4 border rounded bg-white shadow-sm">
          <div class="fw-bold mb-4" style="font-size: 1.1rem;">
            <span class="badge bg-secondary me-2">Câu <%= q_index + 1 %></span><%= question.content %>
          </div>
          
          <!-- HIỂN THỊ ĐÁP ÁN THEO TỪNG LOẠI -->
          <% if question.multiple_choice? %>
            <div class="ps-4">
              <% question.answers.each do |ans| %>
                <div class="form-check mb-2 p-2 rounded <%= ans.is_correct ? 'bg-success text-white fw-bold shadow-sm' : '' %>">
                  <input class="form-check-input" type="radio" disabled <%= 'checked' if ans.is_correct %>>
                  <label class="form-check-label"><%= ans.content %></label>
                </div>
              <% end %>
            </div>
            
          <% elsif question.fill_blank? %>
            <div class="ps-4">
              <span class="text-muted small fw-bold">CÁC ĐÁP ÁN CHẤP NHẬN ĐƯỢC:</span>
              <div class="d-flex flex-wrap gap-2 mt-2">
                <% question.answers.each do |ans| %>
                  <span class="badge bg-success p-2 text-white"><%= ans.content %></span>
                <% end %>
              </div>
            </div>
            
          <% elsif question.matching? %>
            <div class="ps-4">
              <span class="text-muted small fw-bold mb-2 d-block">CÁC CẶP GHÉP ĐÔI:</span>
              <% question.matching_pairs.each do |pair| %>
                <div class="row mb-2 align-items-center">
                  <div class="col-5">
                    <div class="p-2 border rounded bg-light text-center"><%= pair.left_content %></div>
                  </div>
                  <div class="col-2 text-center text-muted fw-bold">↔</div>
                  <div class="col-5">
                    <div class="p-2 border border-success rounded bg-success text-white text-center fw-bold shadow-sm"><%= pair.right_content %></div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
          
          <!-- HIỂN THỊ GIẢI THÍCH (NẾU CÓ) -->
          <% if question.explanation.present? %>
            <hr class="my-3">
            <div class="p-3 bg-light rounded fst-italic text-muted small">
              <strong><i class="bi bi-lightbulb-fill text-warning me-1"></i>Giải thích chung:</strong> 
              <div class="mt-1"><%= question.explanation %></div>
            </div>
          <% end %>
        </div>
      <% end %> <!-- Kết thúc vòng lặp Câu hỏi -->
      
    </div>
  </div>
<% end %> <!-- Kết thúc vòng lặp Section -->

<% if @exam.sections.empty? %>
  <div class="p-5 text-center bg-white rounded shadow-sm text-muted">
    <i class="bi bi-folder-x fs-1 d-block mb-3"></i>
    Bài thi này chưa có nội dung.
  </div>
<% end %>
