<%= form_with(model: [:admin, course], local: true, html: { multipart: true }) do |f| %>
  <% if course.errors.any? %>
    <div class="alert alert-danger shadow-sm">
      <h6 class="alert-heading fw-bold"><%= pluralize(course.errors.count, "error") %> prohibited this course from being saved:</h6>
      <ul class="mb-0">
        <% course.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :title, "Tên khóa học", class: "form-label fw-bold" %>
    <%= f.text_field :title, class: "form-control", placeholder: "Ví dụ: IELTS Master" %>
  </div>

  <div class="mb-3">
    <%= f.label :description, "Mô tả khóa học", class: "form-label fw-bold" %>
    <%= f.text_area :description, rows: 4, class: "form-control", placeholder: "Nhập nội dung mô tả chi tiết cho khóa học..." %>
  </div>

  <div class="mb-3">
    <%= f.label :slug, "Slug (Đường dẫn tĩnh)", class: "form-label fw-bold" %>
    <%= f.text_field :slug, class: "form-control", placeholder: "Để trống để tự động tạo từ tên khóa học" %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :course_type, "Loại khóa học", class: "form-label fw-bold" %>
      <%= f.select :course_type, Course.course_types.keys.map { |type| [type.titleize, type] }, { prompt: "Chọn loại" }, class: "form-select" %>
    </div>
    
    <div class="col-md-6 mb-3">
      <%= f.label :level, "Trình độ", class: "form-label fw-bold" %>
      <%= f.select :level, Course.levels.keys.map { |level| [level.titleize, level] }, { prompt: "Chọn trình độ" }, class: "form-select" %>
    </div>
  </div>

  <div class="mb-4">
    <%= f.label :thumbnail, "Ảnh đại diện (Thumbnail)", class: "form-label fw-bold" %>
    <% if course.thumbnail.attached? %>
      <div class="mb-2">
        <%= image_tag course.thumbnail, class: "img-thumbnail shadow-sm", style: "max-width: 200px;" %>
      </div>
    <% end %>
    <%= f.file_field :thumbnail, class: "form-control", accept: "image/*" %>
  </div>

  <div class="mb-4 form-check">
    <%= f.check_box :is_premium, class: "form-check-input" %>
    <%= f.label :is_premium, "Đánh dấu là Khóa học Premium (trả phí)", class: "form-check-label" %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit "Lưu khóa học", class: "btn btn-primary" %>
    <%= link_to "Hủy", admin_courses_path, class: "btn btn-light border" %>
  </div>
<% end %>
