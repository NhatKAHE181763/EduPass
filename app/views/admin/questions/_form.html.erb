<%= form_with(model: [:admin, @exam, @section, question], class: "needs-validation") do |f| %>
  <% if question.errors.any? %>
    <div class="alert alert-danger">
      <h6 class="alert-heading fw-bold">Có lỗi xảy ra:</h6>
      <ul class="mb-0">
        <% question.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.hidden_field :question_type %>

  <div class="mb-3">
    <%= f.label :content, "Nội dung câu hỏi *", class: "form-label fw-bold" %>
    <%= f.rich_text_area :content, class: "form-control bg-white", style: "min-height: 150px;" %>
  </div>

  <div class="mb-3">
    <%= f.label :explanation, "Giải thích chung cho cả câu hỏi (hiển thị sau khi thi)", class: "form-label fw-bold" %>
    <%= f.rich_text_area :explanation, class: "form-control bg-white", style: "min-height: 100px;" %>
  </div>

  <% if question.multiple_choice? %>
    <%= render "multiple_choice_fields", f: f %>
  <% elsif question.fill_blank? %>
    <%= render "fill_blank_fields", f: f %>
  <% elsif question.matching? %>
    <%= render "matching_fields", f: f %>
  <% end %>

  <div class="d-flex justify-content-end gap-2 mt-4">
    <%= link_to "Hủy", admin_exam_section_path(@exam, @section), class: "btn btn-light" %>
    <%= f.submit question.new_record? ? "Tạo Câu hỏi" : "Cập nhật", class: "btn btn-primary px-4" %>
  </div>
<% end %>
