<%# app/views/students/dashboard/show.html.erb %>
<link rel="stylesheet" href="https://unpkg.com/cal-heatmap/dist/cal-heatmap.css">

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Tổng quan học tập</h2>
  </div>

  <!-- Phần Thống Kê (Thực tế làm bài) -->
  <div class="row mb-5">
    <!-- Card: Tổng bài đã làm -->
    <div class="col-lg-8">

        <!-- Widget Heatmap -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Tần suất luyện tập</h5>
                <select id="heatmapYearSelect" class="form-select form-select-sm w-auto">
                    <% current_year = Date.today.year %>
                    <option value="<%= current_year %>"><%= current_year %></option>
                    <option value="<%= current_year - 1 %>"><%= current_year - 1 %></option>
                    <option value="<%= current_year - 2 %>"><%= current_year - 2 %></option>
                </select>
            </div>
            <div class="card-body overflow-auto">
                <div id="cal-heatmap" style="width: max-content; margin: 0 auto;"></div>
            </div>
        </div>

        <!-- Widget Chart.js -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Tiến độ điểm số (20 bài gần nhất)</h5>
            </div>
            <div class="card-body">
                <canvas id="scoreChart" height="150"></canvas>
            </div>
        </div>
                <!-- Bảng Lịch sử làm bài -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Lịch sử làm bài</h5>
            </div>
            <div class="card-body">
                <!-- Filter Form (Ransack) -->
                <%= search_form_for @q, url: student_dashboard_path, method: :get, class: "row g-3 mb-4" do |f| %>
                    <div class="col-md-5">
                        <%= f.select :exam_course_course_type_eq, 
                        Course.course_types.map { |k, v| [k.upcase, v] }, 
                        { include_blank: "Tất cả các loại bài thi" }, 
                        class: "form-select form-select-sm" %>
                    </div>
                    <div class="col-md-2">
                        <%= f.submit "Lọc", class: "btn btn-sm btn-primary w-100" %>
                    </div>
                <% end %>

                <!-- Table -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th><%= sort_link(@q, :exam_title, "Tên bài thi", default_order: :desc, class: 'text-decoration-none text-dark') %></th>
                                <th>Loại</th>
                                <th>Điểm</th>
                                <th>Thời gian làm</th>
                                <th><%= sort_link(@q, :submitted_at, "Ngày nộp", default_order: :desc, class: 'text-decoration-none text-dark') %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% @exam_attempts.each do |attempt| %>
                                <tr>
                                    <td><span class="fw-medium"><%= attempt.exam.title %></span></td>
                                    <td>
                                        <span class="badge <%= attempt.exam.course.course_type == 'ielts' ? 'bg-primary' : 'bg-success' %>">
                                            <%= attempt.exam.course.course_type.upcase %>
                                        </span>
                                    </td>
                                    <td><span class="fw-bold text-primary"><%= attempt.score || '-' %></span></td>
                                    <td><%= attempt.actual_duration_seconds ? "#{attempt.actual_duration_seconds / 60} phút" : '-' %></td>
                                    <td><%= attempt.submitted_at&.strftime("%d/%m/%Y %H:%M") || '-' %></td>
                                </tr>
                            <% end %>
                        </tbody>
                    </table>
                </div>
                
                <!-- Pagination -->
                <% if @exam_attempts.total_pages > 1 %>
                    <div class="d-flex justify-content-center mt-3">
                        <%= paginate @exam_attempts %>
                    </div>
                <% end %>
            </div>
        </div>

    </div>

    <div class="col-lg-4">
        <!-- Widget Countdown -->
        <% if @upcoming_exam.present? %>
            <div class="card shadow-sm border-0 mb-4 bg-primary text-white">
                <div class="card-body text-center py-4">
                    <h6 class="text-uppercase text-white-50 mb-2">Đếm ngược kỳ thi</h6>
                    <h4 class="fw-bold mb-3"><%= @upcoming_exam.plan_name %></h4>
                    <div class="display-3 fw-bold mb-2">
                        <%= (@upcoming_exam.exam_date - Date.current).to_i %>
                        <span class="fs-4">ngày</span>
                    </div>
                    <p class="mb-0 text-white-50">Ngày thi: <%= @upcoming_exam.exam_date.strftime("%d/%m/%Y") %></p>
                </div>
            </div>
        <% end %>
        <!-- Phần hiển thị Exam Plans -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Kế hoạch thi của bạn</h5>
            <%= link_to "Tạo kế hoạch mới", new_exam_plan_path, class: "btn btn-sm btn-primary" %>
            </div>
            
            <div class="card-body p-0">
            <% if @exam_plans.any? %>
                <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th>Kỳ thi</th>
                        <th>Target score</th>
                        <th>Ngày thi</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                    </thead>
                    <tbody>
                    <% @exam_plans.each do |plan| %>
                        <tr>
                        <td><span class="fw-medium"><%= plan.plan_name %></span></td>
                        <td><span class="badge bg-info"><%= plan.target_score %></span></td>
                        <td><%= plan.exam_date&.strftime("%d/%m/%Y") || "Chưa xác định" %></td>
                        <td class="text-end">
                            <%= link_to "Sửa", edit_exam_plan_path(plan), class: "btn btn-sm btn-outline-secondary" %>
                            <%= link_to "Xóa", exam_plan_path(plan), 
                                data: { turbo_method: :delete, turbo_confirm: "Bạn có chắc chắn muốn xóa kế hoạch này không?" }, 
                                class: "btn btn-sm btn-outline-danger ms-1" %>
                        </td>
                        </tr>
                    <% end %>
                    </tbody>
                </table>
                </div>
            <% else %>
                <div class="text-center py-5">
                <i class="bi bi-clipboard-x text-muted mb-3" style="font-size: 3rem;"></i>
                <h5 class="text-muted">Bạn chưa có kế hoạch nào</h5>
                <p class="text-muted mb-0">Hãy tạo kế hoạch để theo dõi mục tiêu học tập của mình nhé!</p>
                </div>
            <% end %>
            </div>
        </div>
    </div>
    
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script type="module">
  import CalHeatmap from 'cal-heatmap';

  // 1. Khởi tạo Heatmap
  const heatmapContainer = document.getElementById('cal-heatmap');
  if (heatmapContainer) {
    // Xoá sạch HTML bên trong để chống nhân bản khi Turbo load lại
    heatmapContainer.innerHTML = '';
    
    let cal = new CalHeatmap();

    function renderHeatmap(year) {
      let startDate = new Date();
      startDate.setMonth(startDate.getMonth() - 11);
      startDate.setDate(15);
      let sourceUrl = '/student/dashboard/weekly_activity';
      
      if (year) {
        startDate = new Date(year, 0, 15);
        sourceUrl = `/student/dashboard/weekly_activity?year=${year}`;
      }

      cal.paint({
        itemSelector: '#cal-heatmap',
        domain: {
          type: 'month',
          label: { text: 'MMM', textAlign: 'start', position: 'top' },
        },
        subDomain: { type: 'day', radius: 2, width: 15, height: 15 },
        range: 12, // Vẽ 12 tháng
        date: { start: startDate },
        data: {
          source: sourceUrl,
          type: 'json',
          x: 'date',
          y: 'value'
        },
        scale: {
          color: {
            type: 'linear',
            range: ['#ebedf0', '#9be9a8', '#40c463', '#30a14e', '#216e39'], // Tone màu xanh GitHub
            domain: [0, 1, 3, 5, 10]
          }
        }
      });
    }

    const yearSelect = document.getElementById('heatmapYearSelect');
    if (yearSelect) {
      renderHeatmap(yearSelect.value);
      yearSelect.addEventListener('change', (e) => {
        cal.destroy().then(() => {
          cal = new CalHeatmap();
          renderHeatmap(e.target.value);
        });
      });
    } else {
      renderHeatmap();
    }
  }

  // 2. Khởi tạo Chart.js (Mock Data)
  const ctx = document.getElementById('scoreChart');
  if (ctx) {
    // Hủy chart cũ nếu đã tồn tại (chống lỗi Canvas is already in use)
    let existingChart = Chart.getChart(ctx);
    if (existingChart) {
      existingChart.destroy();
    }

    // Mock Labels cho 8 bài gần nhất
    const mockLabels = ["Lần 1", "Lần 2", "Lần 3", "Lần 4", "Lần 5", "Lần 6", "Lần 7", "Lần 8"];
    // Giả sử làm xen kẽ IELTS và TOEIC
    const mockIeltsScores = [5.0, 5.5, 5.5, 6.0, 6.5, null, 6.5, 7.0];
    const mockToeicScores = [null, 750, null, null, 850, 650, null, 900];
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: mockLabels,
        datasets: [
          {
            label: 'IELTS Academic',
            data: mockIeltsScores,
            yAxisID: 'yIelts',
            borderColor: '#0d6efd',
            tension: 0.3,
            spanGaps: true // Thuộc tính này rất quan trọng để nối các điểm qua khoảng null
          },
          {
            label: 'TOEIC',
            data: mockToeicScores,
            yAxisID: 'yToeic',
            borderColor: '#198754',
            tension: 0.3,
            spanGaps: true
          }
        ]
      },
      options: {
        responsive: true,
        interaction: {
          mode: 'index',
          intersect: false,
        },
        plugins: {
          legend: { position: 'bottom' }
        },
        scales: {
          yIelts: {
            type: 'linear',
            display: true,
            position: 'left',
            min: 0,
            max: 9.0,
            title: { display: true, text: 'Điểm IELTS' }
          },
          yToeic: {
            type: 'linear',
            display: true,
            position: 'right',
            min: 0,
            max: 990,
            title: { display: true, text: 'Điểm TOEIC' },
            grid: { drawOnChartArea: false } // Ẩn grid của trục này để không bị rối
          }
        }
      }
    });
  }
</script>