<div class="mb-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Quản lý Bài thi", admin_exams_path, class: "text-decoration-none" %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= @exam.title %></li>
    </ol>
  </nav>
  
  <div class="d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-3">
      <h2 class="fw-bold mb-0"><%= @exam.title %></h2>
      <% if @exam.published? %>
        <span class="badge bg-success">Published</span>
      <% else %>
        <span class="badge bg-secondary">Draft</span>
      <% end %>
    </div>
    
    <div class="d-flex gap-2">
      <%= link_to "Sửa", edit_admin_exam_path(@exam), class: "btn btn-outline-primary" %>
      <%= button_to "Xóa", admin_exam_path(@exam), method: :delete, data: { turbo_confirm: "Bạn có chắc muốn xóa bài thi này?" }, class: "btn btn-outline-danger" %>
    </div>
  </div>
</div>

<div class="row g-4 mt-1">
  <div class="col-md-4">
    <div class="card shadow-sm border-0">
      <div class="card-body bg-light rounded">
        <h5 class="fw-bold mb-3">Thông tin tổng quan</h5>
        <ul class="list-group list-group-flush bg-transparent">
          <li class="list-group-item bg-transparent d-flex justify-content-between px-0">
            <span class="text-muted">Khóa học:</span>
            <strong><%= @exam.course.title %></strong>
          </li>
          <li class="list-group-item bg-transparent d-flex justify-content-between px-0">
            <span class="text-muted">Thời gian:</span>
            <strong><%= @exam.duration_minutes %> phút</strong>
          </li>
          <li class="list-group-item bg-transparent d-flex justify-content-between px-0">
            <span class="text-muted">Slug:</span>
            <span class="small"><%= @exam.slug %></span>
          </li>
          <li class="list-group-item bg-transparent d-flex justify-content-between px-0">
            <span class="text-muted">Người tạo:</span>
            <strong><%= @exam.created_by&.full_name %></strong>
          </li>
        </ul>
      </div>
    </div>
  </div>
  
  <div class="col-md-8">
    <div class="card shadow-sm border-0 h-100 d-flex align-items-center justify-content-center text-center p-5">
      <div class="text-muted">
        <span style="font-size: 3rem;">🛠️</span>
        <h5 class="mt-3">Khu vực quản lý Câu hỏi (Section Builder)</h5>
        <p>Tính năng Builder (Kéo thả câu hỏi) sẽ được phát triển ở các Module tiếp theo.</p>
      </div>
    </div>
  </div>
</div>
