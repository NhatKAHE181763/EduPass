<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="fw-bold">Sửa Khóa học: <%= @course.title %></h2>
  <div>
    <%= link_to "Xem chi tiết", admin_course_path(@course), class: "btn btn-outline-info btn-sm me-2" %>
    <%= link_to "Trở về danh sách", admin_courses_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="card-body p-4">
    <%= render "form", course: @course %>
  </div>
</div>
