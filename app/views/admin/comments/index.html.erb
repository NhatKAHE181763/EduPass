<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h2 fw-bold">Kiểm duyệt Bình luận</h1>
</div>

<div class="card border-0 shadow-sm">
  <div>
    <table class="table align-middle mb-0">
      <thead>
        <tr>
          <th style="width: 35%">Nội dung</th>
          <th style="width: 20%">Người đăng</th>
          <th style="width: 20%">Nơi đăng (Khóa học)</th>
          <th style="width: 15%">Ngày đăng</th>
          <th style="width: 10%" class="text-end">Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if @comments.any? %>
          <%= render partial: "comment", collection: @comments %>
        <% else %>
          <tr>
            <td colspan="5" class="text-center py-4 text-muted">Không có bình luận nào.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="card-footer bg-white pt-3 border-top-0">
    <%= paginate @comments %>
  </div>
</div>
